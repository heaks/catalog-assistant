# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Postgres + pgvector and Redis from ../docker-compose.yml
DATABASE_URL=postgresql://app:app@localhost:5432/catalog
REDIS_URL=redis://localhost:6379

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) | claude-sonnet-5-5 | claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# Per-IP limits for POST /chat
CHAT_LIMIT_PER_MINUTE=10
CHAT_LIMIT_PER_DAY=100

# Optional: CSV used by POST /ingest (path relative to api/)
# INGEST_CSV_PATH=../data/raw/flipkart_com-ecommerce_sample.csv
# PORT=3000
